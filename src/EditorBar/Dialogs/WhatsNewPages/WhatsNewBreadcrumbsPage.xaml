<local:WhatsNewPageControl
    x:Class="JPSoftworks.EditorBar.Dialogs.WhatsNewPages.WhatsNewBreadcrumbsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
    xmlns:local="clr-namespace:JPSoftworks.EditorBar.Dialogs.WhatsNewPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:platformUI="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    d:DesignHeight="260"
    d:DesignWidth="700"
    Heading="Navigate with breadcrumbs"
    Subheading="Your file location and code structure, always within reach."
    mc:Ignorable="d">
    <local:WhatsNewPageControl.Resources>
        <Style x:Key="BreadcrumbPreviewChevronStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.ControlOutlineBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid
                            Height="30"
                            Margin="0,0,-6,0"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                            <StackPanel Height="30" Orientation="Horizontal">
                                <Path
                                    x:Name="StartChevron"
                                    Width="6"
                                    Height="30"
                                    Margin="0,0,-1,0"
                                    Data="M0,0 5,0 5,30 0,30 5,15"
                                    Fill="{TemplateBinding Background}"
                                    SnapsToDevicePixels="True"
                                    Stretch="Fill" />
                                <Grid Height="30" SnapsToDevicePixels="True">
                                    <Rectangle Fill="{TemplateBinding Background}" />
                                    <Border Padding="7,0">
                                        <ContentPresenter
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            Content="{TemplateBinding Content}"
                                            RecognizesAccessKey="False" />
                                    </Border>
                                </Grid>
                                <Path
                                    Width="6"
                                    Height="30"
                                    Margin="-1,0,0,0"
                                    Data="M0,0 5,15 0,30"
                                    Fill="{TemplateBinding Background}"
                                    SnapsToDevicePixels="True"
                                    Stretch="Fill"
                                    Stroke="{TemplateBinding BorderBrush}"
                                    StrokeLineJoin="Round"
                                    StrokeThickness="1" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="First">
                                <Setter TargetName="StartChevron" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:WhatsNewPageControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            x:Name="BreadcrumbsPreviewBorder"
            Height="48"
            AutomationProperties.Name="Editor Bar location and structural breadcrumbs"
            Background="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
            BorderBrush="{DynamicResource {x:Static platformUI:EnvironmentColors.ControlOutlineBrushKey}}"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="6">
            <StackPanel
                Margin="8,5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    x:Name="SolutionPreviewButton"
                    BorderBrush="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                    Content="Solution"
                    Style="{StaticResource BreadcrumbPreviewChevronStyle}"
                    Tag="First" />
                <Button
                    x:Name="SolutionFolderPreviewButton"
                    BorderBrush="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                    Content="Solution folder"
                    Style="{StaticResource BreadcrumbPreviewChevronStyle}" />
                <Button
                    x:Name="ProjectPreviewButton"
                    BorderBrush="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                    Content="Project"
                    Style="{StaticResource BreadcrumbPreviewChevronStyle}" />
                <Button
                    x:Name="ProjectFolderPreviewButton"
                    BorderBrush="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                    Content="Project folder"
                    Style="{StaticResource BreadcrumbPreviewChevronStyle}" />
                <Button
                    x:Name="FilePreviewButton"
                    Style="{StaticResource BreadcrumbPreviewChevronStyle}">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <imaging:CrispImage
                            Width="16"
                            Height="16"
                            Margin="0,0,4,0"
                            Moniker="{x:Static catalog:KnownMonikers.CSFile}" />
                        <TextBlock VerticalAlignment="Center" Text="File" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="ClassPreviewButton"
                    Style="{StaticResource BreadcrumbPreviewChevronStyle}">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <imaging:CrispImage
                            Width="16"
                            Height="16"
                            Margin="0,0,4,0"
                            Moniker="{x:Static catalog:KnownMonikers.Class}" />
                        <TextBlock VerticalAlignment="Center" Text="Class" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="MethodPreviewButton"
                    Style="{StaticResource BreadcrumbPreviewChevronStyle}">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <imaging:CrispImage
                            Width="16"
                            Height="16"
                            Margin="0,0,4,0"
                            Moniker="{x:Static catalog:KnownMonikers.Method}" />
                        <TextBlock VerticalAlignment="Center" Text="Method" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="16"
                BorderBrush="{DynamicResource {x:Static platformUI:EnvironmentColors.ControlOutlineBrushKey}}"
                BorderThickness="1"
                CornerRadius="5">
                <StackPanel>
                    <Border
                        Width="30"
                        Height="5"
                        Margin="0,0,0,14"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource EditorBarAccentBrush}"
                        CornerRadius="2.5" />
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="Location breadcrumbs"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource {x:Static platformUI:EnvironmentColors.SystemGrayTextBrushKey}}"
                        Text="Browse the solution, folders, and files."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="2"
                Padding="16"
                BorderBrush="{DynamicResource {x:Static platformUI:EnvironmentColors.ControlOutlineBrushKey}}"
                BorderThickness="1"
                CornerRadius="5">
                <StackPanel>
                    <Border
                        Width="30"
                        Height="5"
                        Margin="0,0,0,14"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource EditorBarAccentBrush}"
                        CornerRadius="2.5" />
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="Structural breadcrumbs"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource {x:Static platformUI:EnvironmentColors.SystemGrayTextBrushKey}}"
                        Text="Jump between types and members."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="4"
                Padding="16"
                BorderBrush="{DynamicResource {x:Static platformUI:EnvironmentColors.ControlOutlineBrushKey}}"
                BorderThickness="1"
                CornerRadius="5">
                <StackPanel>
                    <Border
                        Width="30"
                        Height="5"
                        Margin="0,0,0,14"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource EditorBarAccentBrush}"
                        CornerRadius="2.5" />
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="Search and act"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource {x:Static platformUI:EnvironmentColors.SystemGrayTextBrushKey}}"
                        Text="Filter popups and choose tree or list results."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</local:WhatsNewPageControl>
