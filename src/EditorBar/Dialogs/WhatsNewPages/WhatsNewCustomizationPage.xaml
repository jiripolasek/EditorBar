<local:WhatsNewPageControl
    x:Class="JPSoftworks.EditorBar.Dialogs.WhatsNewPages.WhatsNewCustomizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JPSoftworks.EditorBar.Dialogs.WhatsNewPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:platformUI="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    d:DesignHeight="260"
    d:DesignWidth="700"
    Heading="Make it yours"
    Subheading="Choose the layout and appearance that fit you."
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Row="0"
            Grid.Column="0"
            Padding="16"
            BorderBrush="{DynamicResource {x:Static platformUI:EnvironmentColors.ControlOutlineBrushKey}}"
            BorderThickness="1"
            CornerRadius="5">
            <StackPanel>
                <Border
                    Width="30"
                    Height="5"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource EditorBarAccentBrush}"
                    CornerRadius="2.5" />
                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="Position" />
                <TextBlock
                    Margin="0,7,0,0"
                    Text="Top, bottom, or beside Zoom."
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border
            Grid.Row="0"
            Grid.Column="2"
            Padding="16"
            BorderBrush="{DynamicResource {x:Static platformUI:EnvironmentColors.ControlOutlineBrushKey}}"
            BorderThickness="1"
            CornerRadius="5">
            <StackPanel>
                <Border
                    Width="30"
                    Height="5"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource EditorBarAccentBrush}"
                    CornerRadius="2.5" />
                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="Display mode" />
                <TextBlock
                    Margin="0,7,0,0"
                    Text="Normal or space-saving Compact."
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border
            Grid.Row="2"
            Grid.Column="0"
            Padding="16"
            BorderBrush="{DynamicResource {x:Static platformUI:EnvironmentColors.ControlOutlineBrushKey}}"
            BorderThickness="1"
            CornerRadius="5">
            <StackPanel>
                <Border
                    Width="30"
                    Height="5"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource EditorBarAccentBrush}"
                    CornerRadius="2.5" />
                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="Breadcrumbs and buttons" />
                <TextBlock
                    Margin="0,7,0,0"
                    Text="Show only what you use."
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border
            Grid.Row="2"
            Grid.Column="2"
            Padding="16"
            BorderBrush="{DynamicResource {x:Static platformUI:EnvironmentColors.ControlOutlineBrushKey}}"
            BorderThickness="1"
            CornerRadius="5">
            <StackPanel>
                <Border
                    Width="30"
                    Height="5"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource EditorBarAccentBrush}"
                    CornerRadius="2.5" />
                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="Appearance" />
                <TextBlock
                    Margin="0,7,0,0"
                    Text="Separate colors for light and dark themes."
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</local:WhatsNewPageControl>
