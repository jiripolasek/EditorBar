<local:WhatsNewPageControl
    x:Class="JPSoftworks.EditorBar.Dialogs.WhatsNewPages.WhatsNewSearchResultsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JPSoftworks.EditorBar.Dialogs.WhatsNewPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:platformUI="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    d:DesignHeight="260"
    d:DesignWidth="700"
    Heading="Tree or list results"
    Subheading="Choose how filtered code-structure results are shown."
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            x:Name="FeatureArtworkBorder"
            Grid.Column="0"
            AutomationProperties.Name="Filtered structural results in a list"
            BorderBrush="{DynamicResource {x:Static platformUI:EnvironmentColors.ControlOutlineBrushKey}}"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="5">
            <Border.Background>
                <ImageBrush
                    x:Name="FeatureArtworkImageBrush"
                    AlignmentX="Left"
                    AlignmentY="Top"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Stretch="UniformToFill" />
            </Border.Background>
        </Border>

        <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <StackPanel>
                <Border
                    Width="30"
                    Height="5"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource EditorBarAccentBrush}"
                    CornerRadius="2.5" />
                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="Tree or List" />
                <TextBlock
                    Margin="0,6,0,0"
                    Foreground="{DynamicResource {x:Static platformUI:EnvironmentColors.SystemGrayTextBrushKey}}"
                    Text="Switch views from More options."
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Margin="0,30,0,0">
                <Border
                    Width="30"
                    Height="5"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource EditorBarAccentBrush}"
                    CornerRadius="2.5" />
                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="Keep your preference" />
                <TextBlock
                    Margin="0,6,0,0"
                    Foreground="{DynamicResource {x:Static platformUI:EnvironmentColors.SystemGrayTextBrushKey}}"
                    Text="Choose a default, or remember the last view."
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </Grid>
</local:WhatsNewPageControl>
