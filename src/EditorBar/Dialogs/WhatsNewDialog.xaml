<platformUI:DialogWindow
    x:Class="JPSoftworks.EditorBar.Dialogs.WhatsNewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:platformUI="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:shell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:whatsNewPages="clr-namespace:JPSoftworks.EditorBar.Dialogs.WhatsNewPages"
    xmlns:windowShell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Width="760"
    Height="570"
    MinWidth="760"
    MinHeight="570"
    Background="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowBorderBrushKey}}"
    FontFamily="{DynamicResource {x:Static shell:VsFonts.EnvironmentFontFamilyKey}}"
    FontSize="{DynamicResource {x:Static shell:VsFonts.EnvironmentFontSizeKey}}"
    Foreground="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowTextBrushKey}}"
    HasDialogFrame="False"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d">
    <windowShell:WindowChrome.WindowChrome>
        <windowShell:WindowChrome
            CaptionHeight="0"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="0"
            UseAeroCaptionButtons="False" />
    </windowShell:WindowChrome.WindowChrome>

    <platformUI:DialogWindow.Resources>
        <SolidColorBrush x:Key="EditorBarAccentBrush" Color="#800080" />
        <SolidColorBrush x:Key="EditorBarAccentTextBrush" Color="#FFFFFF" />

        <Style x:Key="EditorBarCaptionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowButtonActiveGlyphBrushKey}}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBackground" Background="{TemplateBinding Background}">
                            <Path
                                Width="10"
                                Height="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M 0,0 L 10,10 M 10,0 L 0,10"
                                SnapsToDevicePixels="True"
                                Stroke="{TemplateBinding Foreground}"
                                StrokeThickness="1" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowButtonHoverActiveBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowButtonHoverActiveGlyphBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowButtonDownBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowButtonDownActiveGlyphBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowButtonInactiveGlyphBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </platformUI:DialogWindow.Resources>

    <Grid Margin="1" Background="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowBackgroundBrushKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            x:Name="HeaderArtworkBorder"
            Grid.Row="0"
            Grid.RowSpan="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsHitTestVisible="False"
            RenderOptions.BitmapScalingMode="HighQuality"
            Visibility="Collapsed">
            <Border.Background>
                <ImageBrush x:Name="HeaderArtworkBrush" Stretch="UniformToFill" />
            </Border.Background>
        </Border>

        <Border
            Grid.Row="0"
            Grid.RowSpan="2"
            Padding="30,24,30,20"
            BorderBrush="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowBorderBrushKey}}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image
                    x:Name="EditorBarIconImage"
                    Width="64"
                    Height="64"
                    Margin="0,0,20,0"
                    VerticalAlignment="Center"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Stretch="Uniform" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Border
                        Padding="7,3"
                        HorizontalAlignment="Left"
                        Background="{StaticResource EditorBarAccentBrush}"
                        CornerRadius="3">
                        <TextBlock
                            x:Name="DialogMonikerTextBlock"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource EditorBarAccentTextBrush}" />
                    </Border>
                    <TextBlock
                        x:Name="HeadingTextBlock"
                        Margin="0,7,0,0"
                        FontSize="26"
                        FontWeight="SemiBold"
                        Foreground="White"
                        TextAlignment="Left"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="SubheadingTextBlock"
                        Margin="0,7,0,0"
                        Foreground="#C0FFFFFF"
                        TextAlignment="Left"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid
            Grid.Row="0"
            VerticalAlignment="Top"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="46" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="Transparent"
                MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown" />

            <Button
                Grid.Column="1"
                AutomationProperties.Name="Close"
                Click="CaptionCloseButton_OnClick"
                Style="{StaticResource EditorBarCaptionButtonStyle}"
                ToolTip="Close" />
        </Grid>

        <Grid Grid.Row="2" Margin="30,22,30,18">
            <whatsNewPages:WhatsNewBreadcrumbsPage x:Name="BreadcrumbsPage" />
            <whatsNewPages:WhatsNewCompactPositionPage x:Name="CompactPositionPage" Visibility="Collapsed" />
            <whatsNewPages:WhatsNewSearchResultsPage x:Name="SearchResultsPage" Visibility="Collapsed" />
            <whatsNewPages:WhatsNewCustomizationPage x:Name="CustomizationPage" Visibility="Collapsed" />
        </Grid>

        <Border
            Grid.Row="3"
            Padding="18,12"
            BorderBrush="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowBorderBrushKey}}"
            BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        x:Name="PageStatusTextBlock"
                        Margin="0,0,10,0"
                        Foreground="{DynamicResource {x:Static platformUI:EnvironmentColors.SystemGrayTextBrushKey}}" />
                    <StackPanel x:Name="PageIndicatorsPanel" Orientation="Horizontal" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        x:Name="BackButton"
                        MinWidth="84"
                        Margin="0,0,8,0"
                        Padding="12,5"
                        Click="BackButton_OnClick"
                        Content="_Back"
                        Style="{DynamicResource {x:Static shell:VsResourceKeys.ThemedDialogButtonStyleKey}}" />
                    <Button
                        MinWidth="112"
                        Margin="0,0,8,0"
                        Padding="12,5"
                        Click="ViewChangelogButton_OnClick"
                        Content="_View Changelog"
                        Style="{DynamicResource {x:Static shell:VsResourceKeys.ThemedDialogButtonStyleKey}}" />
                    <Button
                        x:Name="OpenOptionsButton"
                        MinWidth="106"
                        Margin="0,0,8,0"
                        Padding="12,5"
                        Click="OpenOptionsButton_OnClick"
                        Content="_Open Options..."
                        Style="{DynamicResource {x:Static shell:VsResourceKeys.ThemedDialogButtonStyleKey}}"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="NextButton"
                        MinWidth="84"
                        Padding="12,5"
                        Click="NextButton_OnClick"
                        Content="_Next"
                        IsDefault="True"
                        Style="{DynamicResource {x:Static shell:VsResourceKeys.ThemedDialogButtonStyleKey}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</platformUI:DialogWindow>
