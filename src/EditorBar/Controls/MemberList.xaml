<UserControl
    x:Class="JPSoftworks.EditorBar.Controls.MemberList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:JPSoftworks.EditorBar.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:platformUI="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:platformUIImaging="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Imaging"
    xmlns:platofrmUIUtilities="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Utilities"
    xmlns:presentation="clr-namespace:JPSoftworks.EditorBar.Presentation"
    xmlns:shell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:viewModels="clr-namespace:JPSoftworks.EditorBar.ViewModels"
    x:Name="root"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Focusable="False"
    IsTabStop="False"
    KeyboardNavigation.TabNavigation="Local"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/EditorBar;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <platofrmUIUtilities:BrushToColorConverter x:Key="BrushToColorConverter" />

            <DataTemplate x:Key="DataTemplate" DataType="{x:Type viewModels:MemberListItemViewModel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" SharedSizeGroup="C1" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="C2" />
                    </Grid.ColumnDefinitions>

                    <controls:IconDisplay
                        VerticalAlignment="Center"
                        Icon="{Binding Path=(viewModels:MemberListItemViewModel.Icon)}"
                        ImageMoniker="{Binding Path=(viewModels:MemberListItemViewModel.ImageMoniker)}" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource {x:Static shell:VsBrushes.CommandBarTextActiveKey}}"
                        Text="{Binding Path=(viewModels:MemberListItemViewModel.PrimaryName)}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="3"
                        Margin="{StaticResource PopupMemberSecondaryTextMargin}"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource {x:Static shell:VsFonts.Environment90PercentFontSizeKey}}"
                        Foreground="{DynamicResource {x:Static shell:VsBrushes.CommandBarTextInactiveKey}}"
                        Text="{Binding Path=(viewModels:MemberListItemViewModel.SecondaryName)}"
                        TextAlignment="Right"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="SeparatorTemplate" DataType="{x:Type viewModels:SeparatorListItemViewModel}">
                <Separator Focusable="False" IsHitTestVisible="False">
                    <Separator.Template>
                        <!--  horizontal separator rule  -->
                        <ControlTemplate>
                            <Rectangle
                                Height="2"
                                HorizontalAlignment="Stretch"
                                Fill="Gray"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True" />
                        </ControlTemplate>
                    </Separator.Template>
                </Separator>
            </DataTemplate>


            <Style x:Key="SeparatorItemContainerStyle" TargetType="ListBoxItem">
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
            </Style>


            <Style x:Key="NormalItemContainerStyle" TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Focusable" Value="True" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="{StaticResource PopupMemberListItemMargin}" />
                <Setter Property="Padding" Value="{StaticResource PopupMemberItemPadding}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border
                                x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        x:Name="SelectionIndicator"
                                        Grid.Column="0"
                                        Width="4"
                                        Margin="{StaticResource PopupMemberListSelectionIndicatorMargin}"
                                        HorizontalAlignment="Center"
                                        Background="Transparent"
                                        CornerRadius="2"
                                        Visibility="Visible" />
                                    <ContentPresenter
                                        Grid.Column="1"
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.AccentLightBrushKey}}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.AccentPaleBrushKey}}" />
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.AccentLightBrushKey}}" />
                                    <Setter TargetName="SelectionIndicator" Property="Background" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.SystemHighlightBrushKey}}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <presentation:SymbolDateTemplateSelector
                x:Key="SymbolDateTemplateSelector"
                SeparatorTemplate="{StaticResource SeparatorTemplate}"
                SymbolTemplate="{StaticResource DataTemplate}" />
            <presentation:MyItemContainerStyleSelector
                x:Key="MyItemContainerStyleSelector"
                NormalItemStyle="{StaticResource NormalItemContainerStyle}"
                SeparatorItemStyle="{StaticResource SeparatorItemContainerStyle}" />

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Style="{StaticResource PopupFilterHeaderStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox
                x:Name="FilterTextBox"
                Grid.Column="0"
                PreviewKeyDown="FilterTextBox_OnKeyDown"
                Style="{StaticResource PopupFilterTextBoxStyle}"
                Tag="Filter members"
                TextChanged="FilterTextBox_TextChanged"
                Visibility="Collapsed" />

            <Button
                x:Name="ExpandedMoreOptionsButton"
                Grid.Column="1"
                AutomationProperties.Name="More options"
                Click="MoreOptionsButton_OnClick"
                Style="{StaticResource ExpandedMoreOptionsButtonStyle}"
                TabIndex="2" />

            <Border
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Height="1"
                Background="{DynamicResource {x:Static platformUI:CommonControlsColors.TextBoxBorderBrushKey}}"
                IsHitTestVisible="False"
                SnapsToDevicePixels="True"
                Visibility="{Binding Visibility, ElementName=FilterTextBox}" />
        </Grid>

        <!--  Content area with list and placeholders overlayed  -->
        <Grid Grid.Row="1" Margin="1,0,1,1">
            <ListBox
                x:Name="ListBox"
                MinWidth="220"
                Background="{DynamicResource {x:Static platformUI:ThemedDialogColors.ListBoxBrushKey}}"
                Style="{StaticResource PopupListBoxStyle}"
                Padding="0"
                platformUIImaging:ImageThemingUtilities.ImageBackgroundColor="{Binding Background, RelativeSource={RelativeSource Self}, Converter={StaticResource BrushToColorConverter}}"
                BorderThickness="0"
                Focusable="True"
                GotKeyboardFocus="ListBox_OnGotKeyboardFocus"
                Grid.IsSharedSizeScope="True"
                IsSynchronizedWithCurrentItem="True"
                IsTextSearchCaseSensitive="False"
                IsTextSearchEnabled="True"
                ItemContainerStyleSelector="{StaticResource MyItemContainerStyleSelector}"
                ItemTemplateSelector="{StaticResource SymbolDateTemplateSelector}"
                KeyboardNavigation.ControlTabNavigation="Cycle"
                KeyboardNavigation.DirectionalNavigation="Cycle"
                MouseLeftButtonUp="ListBox_OnMouseLeftButtonDown"
                PreviewKeyDown="ListBox_OnPreviewKeyDown"
                PreviewTextInput="ListBox_OnPreviewTextInput"
                TabIndex="0"
                TextSearch.TextPath="SearchText">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <TextBlock
                x:Name="EmptyPlaceholder"
                Padding="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontStyle="Italic"
                Foreground="{DynamicResource {x:Static shell:VsBrushes.CommandBarTextInactiveKey}}"
                Text="No members found."
                Visibility="Collapsed" />
            <TextBlock
                x:Name="FilteredPlaceholder"
                Padding="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontStyle="Italic"
                Foreground="{DynamicResource {x:Static shell:VsBrushes.CommandBarTextInactiveKey}}"
                Text="No matches for current filter."
                Visibility="Collapsed" />
        </Grid>

        <Button
            x:Name="CompactMoreOptionsButton"
            Grid.Row="1"
            Panel.ZIndex="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            AutomationProperties.Name="More options"
            Click="MoreOptionsButton_OnClick"
            Style="{StaticResource CompactMoreOptionsButtonStyle}"
            TabIndex="2" />
    </Grid>
</UserControl>
