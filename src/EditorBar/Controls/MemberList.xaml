<UserControl
    x:Class="JPSoftworks.EditorBar.Controls.MemberList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:JPSoftworks.EditorBar.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:platformUI="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:platformUIImaging="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Imaging"
    xmlns:platofrmUIUtilities="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Utilities"
    xmlns:presentation="clr-namespace:JPSoftworks.EditorBar.Presentation"
    xmlns:shell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:viewModels="clr-namespace:JPSoftworks.EditorBar.ViewModels"
    x:Name="root"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Focusable="False"
    IsTabStop="False"
    KeyboardNavigation.TabNavigation="Local"
    mc:Ignorable="d">
    <UserControl.Resources>

        <platofrmUIUtilities:BrushToColorConverter x:Key="BrushToColorConverter" />

        <DataTemplate x:Key="DataTemplate" DataType="{x:Type viewModels:MemberListItemViewModel}">
            <Grid Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" SharedSizeGroup="C1" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="C2" />
                </Grid.ColumnDefinitions>

                <controls:IconDisplay Icon="{Binding Path=(viewModels:MemberListItemViewModel.Icon)}" ImageMoniker="{Binding Path=(viewModels:MemberListItemViewModel.ImageMoniker)}" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Text="{Binding Path=(viewModels:MemberListItemViewModel.PrimaryName)}" />
                <TextBlock
                    Grid.Column="3"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource {x:Static shell:VsFonts.Environment90PercentFontSizeKey}}"
                    Opacity=".5"
                    Text="{Binding Path=(viewModels:MemberListItemViewModel.SecondaryName)}"
                    TextAlignment="Right" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SeparatorTemplate" DataType="{x:Type viewModels:SeparatorListItemViewModel}">
            <Separator Focusable="False" IsHitTestVisible="False">
                <Separator.Template>
                    <!--  horizontal separator rule  -->
                    <ControlTemplate>
                        <Rectangle
                            Height="2"
                            HorizontalAlignment="Stretch"
                            Fill="Gray"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True" />
                    </ControlTemplate>
                </Separator.Template>
            </Separator>
        </DataTemplate>


        <Style x:Key="SeparatorItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
        </Style>


        <Style x:Key="NormalItemContainerStyle" TargetType="ListBoxItem" />

        <presentation:SymbolDateTemplateSelector
            x:Key="SymbolDateTemplateSelector"
            SeparatorTemplate="{StaticResource SeparatorTemplate}"
            SymbolTemplate="{StaticResource DataTemplate}" />
        <presentation:MyItemContainerStyleSelector
            x:Key="MyItemContainerStyleSelector"
            NormalItemStyle="{StaticResource NormalItemContainerStyle}"
            SeparatorItemStyle="{StaticResource SeparatorItemContainerStyle}" />

        <Style x:Key="FilterBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="6,4,6,4" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platformUI:CommonControlsColors.TextBoxBorderBrushKey}}" />
            <Setter Property="Background" Value="{DynamicResource {x:Static platformUI:CommonControlsColors.TextBoxBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUI:CommonControlsColors.TextBoxTextBrushKey}}" />
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platformUI:CommonControlsColors.TextBoxBorderBrushKey}}" />
                    <Setter Property="Background" Value="{DynamicResource {x:Static platformUI:CommonControlsColors.TextBoxBackgroundFocusedBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUI:CommonControlsColors.TextBoxTextFocusedBrushKey}}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBox
            x:Name="FilterTextBox"
            PreviewKeyDown="FilterTextBox_OnKeyDown"
            Style="{StaticResource FilterBoxStyle}"
            TextChanged="FilterTextBox_TextChanged"
            Visibility="Collapsed" />

        <!--  Content area with list and placeholders overlayed  -->
        <Grid Grid.Row="1">
            <ListBox
                x:Name="ListBox"
                MinWidth="220"
                platformUIImaging:ImageThemingUtilities.ImageBackgroundColor="{Binding Background, RelativeSource={RelativeSource Self}, Converter={StaticResource BrushToColorConverter}}"
                BorderThickness="0"
                Focusable="True"
                Grid.IsSharedSizeScope="True"
                IsSynchronizedWithCurrentItem="True"
                IsTextSearchCaseSensitive="False"
                IsTextSearchEnabled="True"
                ItemContainerStyleSelector="{StaticResource MyItemContainerStyleSelector}"
                ItemTemplateSelector="{StaticResource SymbolDateTemplateSelector}"
                KeyboardNavigation.ControlTabNavigation="Cycle"
                KeyboardNavigation.DirectionalNavigation="Cycle"
                MouseLeftButtonUp="ListBox_OnMouseLeftButtonDown"
                PreviewKeyDown="ListBox_OnPreviewKeyDown"
                PreviewTextInput="ListBox_OnPreviewTextInput"
                TabIndex="0"
                TextSearch.TextPath="SearchText">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <TextBlock
                x:Name="EmptyPlaceholder"
                Padding="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontStyle="Italic"
                Foreground="{DynamicResource {x:Static shell:VsBrushes.CommandBarTextInactiveKey}}"
                Text="No members found."
                Visibility="Collapsed" />
            <TextBlock
                x:Name="FilteredPlaceholder"
                Padding="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontStyle="Italic"
                Foreground="{DynamicResource {x:Static shell:VsBrushes.CommandBarTextInactiveKey}}"
                Text="No matches for current filter."
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>