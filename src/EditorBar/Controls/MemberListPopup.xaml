<Popup
    x:Class="JPSoftworks.EditorBar.Controls.MemberListPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:platformUI="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"
    x:Name="RootElement"
    MaxHeight="600"
    d:DesignHeight="450"
    d:DesignWidth="800"
    toolkit:Themes.UseVsTheme="True"
    AllowsTransparency="true"
    Placement="Bottom"
    StaysOpen="False"
    mc:Ignorable="d">
    <platformUI:SystemDropShadowChrome
        Margin="0,0,5,5"
        CornerRadius="7"
        Color="#33000000">
        <Border
            x:Name="PopupBorder"
            Padding="4"
            Background="{DynamicResource {x:Static platformUI:ThemedDialogColors.ListBoxBrushKey}}"
            BorderBrush="{DynamicResource {x:Static platformUI:ThemedDialogColors.ListBoxBorderBrushKey}}"
            BorderThickness="1"
            CornerRadius="7"
            Focusable="False">
            <ContentPresenter
                x:Name="ContentPresenter"
                Content="{Binding Content, ElementName=RootElement}"
                KeyboardNavigation.TabIndex="0" />
        </Border>
    </platformUI:SystemDropShadowChrome>
</Popup>