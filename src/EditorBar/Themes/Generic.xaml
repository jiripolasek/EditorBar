<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
    xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
    xmlns:platformUI="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Utilities"
    xmlns:platformUIShell="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:presentation="clr-namespace:JPSoftworks.EditorBar.Presentation"
    xmlns:shell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>

        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <platformUI:BrushToColorConverter x:Key="BrushToColorConverter" />
            <presentation:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />
            <presentation:OrConverter x:Key="OrConverter" />
        </ResourceDictionary>

        <ResourceDictionary Source="Generic.ChevronButton.xaml" />

        <ResourceDictionary>
            <Thickness x:Key="PopupMemberItemPadding">8,5,8,5</Thickness>
            <Thickness x:Key="PopupMemberListItemMargin">3,0</Thickness>
            <Thickness x:Key="PopupMemberTreeItemMargin">0,0,0,0</Thickness>
            <Thickness x:Key="PopupMemberSecondaryTextMargin">12,0,0,0</Thickness>
            <Thickness x:Key="PopupMemberListSelectionIndicatorMargin">3,5,3,5</Thickness>
            <Thickness x:Key="PopupMemberTreeSelectionIndicatorMargin">3,3,3,3</Thickness>
            <Thickness x:Key="PopupMemberTreeExpanderMargin">1,0,1,0</Thickness>

            <!--  control button on the right  -->
            <Style x:Key="CommandBarBorderStyle" TargetType="Border">
                <Setter Property="Opacity" Value="0" />
                <Style.Triggers>
                    <DataTrigger Value="True">
                        <DataTrigger.Binding>
                            <MultiBinding Converter="{StaticResource OrConverter}">
                                <Binding ElementName="EditorBarBorder" Path="IsMouseOver" />
                                <Binding ElementName="RootControl" Path="IsKeyboardFocusWithin" />
                            </MultiBinding>
                        </DataTrigger.Binding>
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetProperty="Opacity"
                                        To="1"
                                        Duration="0:0:0.2" />
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetProperty="Opacity"
                                        To="0"
                                        Duration="0:0:0.4" />
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PopupFilterTextBoxStyle" TargetType="TextBox">
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Margin" Value="1" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platformUIShell:CommonControlsColors.TextBoxBorderBrushKey}}" />
                <Setter Property="Background" Value="{DynamicResource {x:Static platformUIShell:CommonControlsColors.TextBoxBackgroundBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUIShell:CommonControlsColors.TextBoxTextBrushKey}}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <imaging:CrispImage
                                        Grid.Column="0"
                                        Width="16"
                                        Height="16"
                                        Margin="8,0,6,0"
                                        VerticalAlignment="Center"
                                        Moniker="{x:Static catalog:KnownMonikers.Search}" />
                                    <ScrollViewer
                                        x:Name="PART_ContentHost"
                                        Grid.Column="1"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    <TextBlock
                                        x:Name="PlaceholderText"
                                        Grid.Column="1"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource {x:Static shell:VsBrushes.CommandBarTextInactiveKey}}"
                                        IsHitTestVisible="False"
                                        Text="{TemplateBinding Tag}"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource {x:Static platformUIShell:CommonControlsColors.TextBoxBackgroundFocusedBrushKey}}" />
                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUIShell:CommonControlsColors.TextBoxTextFocusedBrushKey}}" />
                                </Trigger>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>

        <ResourceDictionary Source="pack://application:,,,/EditorBar;component/Themes/EditorBar.Normal.xaml" />

    </ResourceDictionary.MergedDictionaries>


</ResourceDictionary>
